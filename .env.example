# Copy this file to .env and adjust the values.
# NEVER commit the actual .env file to the repository.

# Database — used by Prisma locally; docker-compose builds its own URL
# from DB_PASSWORD below.
DATABASE_URL=postgresql://inventaris:change-me@localhost:5432/inventaris?schema=public

# Password for the PostgreSQL container (docker compose)
DB_PASSWORD=change-me

# Secret key for signing session JWTs (use a long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin created by `npm run db:seed` / container startup
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
